{
  "name": "trazo-stickers",
  "version": "0.4.0",
  "description": "Hand-drawn crayon sticker SVGs for React, Vue, Svelte, and web interfaces.",
  "homepage": "https://trazo.akoder.xyz",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "svelte": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "default": "./dist/svg.js"
    },
    "./meta": {
      "types": "./dist/catalog-meta.d.ts",
      "import": "./dist/catalog-meta.js",
      "default": "./dist/catalog-meta.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./scribble": {
      "types": "./dist/scribble.d.ts",
      "import": "./dist/scribble.js",
      "default": "./dist/scribble.js"
    },
    "./catalog/*": {
      "types": "./dist/catalog/*.d.ts",
      "import": "./dist/catalog/*.js",
      "default": "./dist/catalog/*.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svg",
    "stickers",
    "crayon",
    "scribbles",
    "hand-drawn",
    "icons",
    "react",
    "vue",
    "svelte"
  ],
  "author": "Aditya Ojha",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": "^3.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
