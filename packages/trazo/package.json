{
  "name": "trazo-stickers",
  "version": "0.1.5",
  "description": "Hand-drawn crayon sticker SVGs for React and web interfaces.",
  "homepage": "https://trazo.akoder.xyz",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "default": "./dist/svg.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svg",
    "stickers",
    "crayon",
    "scribbles",
    "hand-drawn",
    "icons",
    "react"
  ],
  "author": "Aditya Ojha",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
